# Optional. Set to your real public HTTPS domain on Vercel.
# Without it, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL is used when available.
NEXT_PUBLIC_SITE_URL=
# Leave empty on Vercel. The old GitHub Pages subpath is no longer the target.
NEXT_PUBLIC_BASE_PATH=
# Ignored. Static export cannot host the Clerk proxy. See docs/AUTH.md.
GITHUB_PAGES=false
# Clerk app already created, Development instance: app_3JxoXh0l1EQ
# https://dashboard.clerk.com/apps/app_3JxoXh0l1EQ
# On a machine where `clerk auth login` has succeeded (not CI):
#   npx clerk@latest link --app app_3JxoXh0l1EQ
#   npx clerk@latest env pull
# That writes .env.local. Do not commit it. Leave the values below empty in git.
# Development keys are pk_test_ / sk_test_. Production is another instance
# (pk_live_ / sk_live_): `npx clerk@latest env pull --app app_3JxoXh0l1EQ --instance prod`
# Keyless provisioning is forced off in next.config. See docs/AUTH.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/compte
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/compte
# Provisional mailbox supplied in the brief. No backend sends messages.
NEXT_PUBLIC_CONTACT_EMAIL=HelveticVault@gmail.com
# The studio needs no render secret: each adherent links their own Comfy Cloud
# account in the app (session or API key, kept on their device). See docs/COMFY-STACK.md.
# Dormant since the studio-direct rebuild: the app no longer reads the share-app
# links or the fal proxy URL. Only the dataset-gate report and workers/fal-proxy use them.
NEXT_PUBLIC_COMFY_TRAIN_APP_URL=
NEXT_PUBLIC_COMFY_PROMPT_APP_URL=
NEXT_PUBLIC_COMFY_ENTRE_APP_URL=
# Never put FAL_KEY or ACCESS_TOKEN here, nor in any NEXT_PUBLIC_* variable.
# The studio asks for the adherent's own fal key in the app. It stays on the device.
# The proxy URL below is only for the dormant Flux worker.
NEXT_PUBLIC_FAL_PROXY_URL=
