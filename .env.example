# Optional. Set to your real public HTTPS domain on Vercel.
# Without it, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL is used when available.
NEXT_PUBLIC_SITE_URL=
# Leave empty on Vercel. The old GitHub Pages subpath is no longer the target.
NEXT_PUBLIC_BASE_PATH=
# Ignored. Static export cannot host the Comfy proxy (src/proxy.ts).
GITHUB_PAGES=false
# Provisional mailbox supplied in the brief. No backend sends messages.
NEXT_PUBLIC_CONTACT_EMAIL=HelveticVault@gmail.com
# The studio needs no render secret: each adherent links their own Comfy Cloud
# account in the app (session or API key, kept on their device). See docs/COMFY-STACK.md.
# Dormant since the studio-direct rebuild: the app no longer reads the share-app links.
NEXT_PUBLIC_COMFY_TRAIN_APP_URL=
NEXT_PUBLIC_COMFY_PROMPT_APP_URL=
NEXT_PUBLIC_COMFY_ENTRE_APP_URL=
# Never put an ACCESS_TOKEN here, nor in any NEXT_PUBLIC_* variable.
# Optional free Mapillary client token (MLY|…). When set, the décor photo picker adds Mapillary
# photos and 360° views next to Panoramax. Panoramax needs no token; without this the app works.
# A NEXT_PUBLIC_ value ships in the browser bundle: that is how Mapillary client tokens are meant
# to be used. Create one at https://www.mapillary.com/dashboard/developers with READ access.
# If bbox searches return {"data":[]} everywhere, register a fresh app with READ only.
NEXT_PUBLIC_MAPILLARY_TOKEN=
