# Optional. Set to your real public HTTPS domain on Vercel.
# Without it, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL is used when available.
NEXT_PUBLIC_SITE_URL=
# Leave empty on Vercel. The old GitHub Pages subpath is no longer the target.
NEXT_PUBLIC_BASE_PATH=
# Ignored. Static export cannot host the Clerk proxy. See docs/AUTH.md.
GITHUB_PAGES=false
# Clerk. Both empty: the site builds, Créer stays open, Compte shows a placeholder.
# Keyless provisioning is forced off in next.config. Do not put test keys in git.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/#compte
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/#compte
# Provisional mailbox supplied in the brief. No backend sends messages.
NEXT_PUBLIC_CONTACT_EMAIL=HelveticVault@gmail.com
# Optional: replace the Comfy Cloud App Mode share links (defaults live in src/lib/comfy-stack.ts).
NEXT_PUBLIC_COMFY_TRAIN_APP_URL=
NEXT_PUBLIC_COMFY_PROMPT_APP_URL=
# Optional: public URL of the fal proxy (workers/fal-proxy). Empty = bootstrap and train stay disabled (« proxy non branché »).
# Never put FAL_KEY or ACCESS_TOKEN here, nor in any NEXT_PUBLIC_* variable. They live in the Worker secrets.
NEXT_PUBLIC_FAL_PROXY_URL=
