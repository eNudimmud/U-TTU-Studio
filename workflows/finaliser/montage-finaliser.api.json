{
  "load": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "uttu-montage.mp4"
    },
    "_meta": {
      "title": "Montage"
    }
  },
  "parts": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "load",
        0
      ]
    },
    "_meta": {
      "title": "Images"
    }
  },
  "upscale": {
    "class_type": "RTXVideoSuperResolution",
    "inputs": {
      "images": [
        "parts",
        0
      ],
      "resize_type": "target dimensions",
      "resize_type.width": 1920,
      "resize_type.height": 1080,
      "quality": "ULTRA",
      "strength": 1,
      "image_encoding": "8-bit RGB"
    },
    "_meta": {
      "title": "Finaliser"
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "upscale",
        0
      ],
      "audio": [
        "parts",
        1
      ],
      "fps": [
        "parts",
        2
      ]
    },
    "_meta": {
      "title": "Vidéo"
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "uttu-final-1080p",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 16
    },
    "_meta": {
      "title": "Enregistrer"
    }
  }
}
