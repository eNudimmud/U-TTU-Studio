{
  "voice": {
    "class_type": "ElevenLabsVoiceSelector",
    "inputs": {
      "voice": "Sarah (female, american)"
    },
    "_meta": {
      "title": "Voix"
    }
  },
  "stem": {
    "class_type": "ElevenLabsTextToSpeech",
    "inputs": {
      "voice": [
        "voice",
        0
      ],
      "text": "<texte du visiteur>",
      "stability": 0.5,
      "apply_text_normalization": "auto",
      "model": "eleven_v4",
      "model.similarity_boost": 0.75,
      "language_code": "",
      "seed": 0,
      "output_format": "mp3_44100_192"
    },
    "_meta": {
      "title": "Parole"
    }
  },
  "save": {
    "class_type": "SaveAudioAdvanced",
    "inputs": {
      "audio": [
        "stem",
        0
      ],
      "filename_prefix": "uttu-voix",
      "format": "mp3",
      "format.quality": "V0"
    },
    "_meta": {
      "title": "Enregistrer"
    }
  }
}
